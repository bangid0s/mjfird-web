# Canonical site URL (no trailing slash) — used for sitemap, RSS, social metadata
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the client. Required for PayPal sandbox capture
# writes (Vercel Preview and .env.local). The browser never receives this.
SUPABASE_SERVICE_ROLE_KEY=

# Resend — all email notifications (inquiries, commission updates, payments).
# Without RESEND_API_KEY nothing is sent. INQUIRY_NOTIFY_EMAIL is where studio alerts go.
RESEND_API_KEY=
INQUIRY_NOTIFY_EMAIL=hello@mjfird.com

# Cloudflare Turnstile (spam protection on the inquiry form)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Sender for transactional emails (must be on the domain verified in Resend)
RESEND_FROM=MJFIRD <notifications@mjfird.com>

# PayPal stays off unless PAYPAL_ENV is exactly sandbox and every name below is set.
# Any other value, including live, disables checkout. There is no live mode.
# Server-only: Vercel Preview and .env.local. Do not prefix these with NEXT_PUBLIC_.
PAYPAL_ENV=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Public sandbox client id for the PayPal JS SDK (browser). Vercel Preview and .env.local.
# Use the sandbox app's client id, the same app as PAYPAL_CLIENT_ID.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Server-only. When set, a capture must report this PayPal merchant id or the request is not marked paid.
PAYPAL_MERCHANT_ID=
